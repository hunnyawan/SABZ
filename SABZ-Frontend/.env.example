# ──────────────────────────────────────────────────────────────
# SABZ Frontend Environment Variables
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Backend API base URL
# Leave empty to use the Vite dev-server proxy (recommended for local dev).
# Set to the full URL only if the frontend and backend are on different hosts.
VITE_API_BASE_URL=

# ── AI Vision (disease detection / plant identification) ──────
# Provide at least one. Gemini is tried first; OpenRouter is the fallback.

# Google Gemini API key  (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# OpenRouter API key  (https://openrouter.ai/keys)
# Also used for voice-to-text transcription.
VITE_OPENROUTER_API_KEY=

# ── Groq (optional — fast voice/chat inference) ──────────────
# Groq API key  (https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# ── Satellite Crop Health (NDVI) ─────────────────────────────
# AgroMonitoring API key  (https://agromonitoring.com/)
VITE_AGROMONITORING_API_KEY=
