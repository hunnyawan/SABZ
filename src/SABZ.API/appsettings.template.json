{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SabzDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "SABZ",
    "Audience": "SABZ",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
  },
  "Weather": {
    "BaseUrl": "https://api.open-meteo.com",
    "TimeoutSeconds": 15,
    "CurrentCacheMinutes": 15,
    "ForecastCacheMinutes": 60,
    "ForecastDays": 7,
    "CoordinatePrecision": 2
  },
  "DiseaseDetection": {
    "Provider": "DashScope",
    "Model": "qwen-vl-max",
    "ApiBaseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "ApiKey": "REPLACE_WITH_YOUR_AI_PROVIDER_API_KEY_LOCAL_ONLY",
    "TimeoutSeconds": 60,
    "PlantConfidenceThreshold": 0.6,
    "HighConfidenceThreshold": 0.7,
    "MinimumDiseaseConfidence": 0.4,
    "MaxImageSizeMb": 10,
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "MinImageWidth": 128,
    "MinImageHeight": 128,
    "MaxImageWidth": 6000,
    "MaxImageHeight": 6000,
    "BlurVarianceThreshold": 40
  },
  "Agronomist": {
    "ChatModel": "qwen-plus",
    "SpeechToTextModel": "qwen2-audio-instruct",
    "MaxQuestionLength": 1000,
    "MaxAudioSizeMb": 10,
    "AllowedAudioTypes": [ "audio/wav", "audio/x-wav", "audio/wave", "audio/vnd.wave", "audio/mpeg", "audio/mp3", "audio/mp4", "audio/x-m4a", "audio/flac", "audio/ogg" ],
    "MaxActiveCropsInContext": 10,
    "MaxDiseaseReferencesInContext": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
